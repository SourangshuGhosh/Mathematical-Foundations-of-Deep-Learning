"""
Illustration of the Kolmogorov-Arnold Superposition Theorem: Showing how a 2D continuous function can be approximated using sums of univariate functions of linear combinations.
"""

import numpy as np
import matplotlib.pyplot as plt

# --- Target function f(x,y) ---
def f(x, y):
    return np.sin(np.pi * x) * np.cos(np.pi * y)

# --- Toy superposition decomposition ---
# We'll handcraft psi and Phi to approximate f(x,y).
def psi11(x): return x
def psi21(y): return y
def psi12(x): return -x
def psi22(y): return y

def Phi1(z): return np.sin(np.pi * z)   # expects x+y structure
def Phi2(z): return np.cos(np.pi * z)   # expects -x+y structure

def f_superposed(x, y):
    return 0.5*Phi1(psi11(x) + psi21(y)) + 0.5*Phi2(psi12(x) + psi22(y))

# --- Grid for plotting ---
N = 200
X = np.linspace(0, 1, N)
Y = np.linspace(0, 1, N)
XX, YY = np.meshgrid(X, Y)

F = f(XX, YY)
F_sup = f_superposed(XX, YY)
Error = np.abs(F - F_sup)

# --- Plot results ---
fig, axs = plt.subplots(1, 3, figsize=(15, 4))

cs0 = axs[0].contourf(XX, YY, F, levels=50, cmap="viridis")
axs[0].set_title("Original f(x,y)")
fig.colorbar(cs0, ax=axs[0])

cs1 = axs[1].contourf(XX, YY, F_sup, levels=50, cmap="viridis")
axs[1].set_title("Superposed Approximation")
fig.colorbar(cs1, ax=axs[1])

cs2 = axs[2].contourf(XX, YY, Error, levels=50, cmap="inferno")
axs[2].set_title("Absolute Error")
fig.colorbar(cs2, ax=axs[2])

for ax in axs:
    ax.set_xlabel("x")
    ax.set_ylabel("y")

plt.suptitle("Kolmogorov-Arnold Superposition Theorem (Toy Example)", fontsize=14)
plt.tight_layout()
plt.show()
