import torch
import torch.nn as nn
import matplotlib.pyplot as plt

# ==========================
# 1. Define a simple MLP
# ==========================
class Net(nn.Module):
    def __init__(self, d_in, d_hidden, d_out):
        super().__init__()
        self.fc1 = nn.Linear(d_in, d_hidden)
        self.fc2 = nn.Linear(d_hidden, d_out)

    def forward(self, x):
        return torch.tanh(self.fc1(x)) @ self.fc2.weight.T + self.fc2.bias

# ==========================
# 2. Compute NTK
# ==========================
def compute_ntk(model, x):
    f = model(x)
    grads = []

    for i in range(f.shape[0]):
        grad = torch.autograd.grad(f[i, 0], model.parameters(), retain_graph=True, create_graph=True)
        grads.append(torch.cat([g.reshape(-1) for g in grad]))

    grads = torch.stack(grads)
    NTK = grads @ grads.T
    return NTK.detach()

# ==========================
# 3. Compute Hessian
# ==========================
def compute_hessian(loss, params):
    grads = torch.autograd.grad(loss, params, create_graph=True)
    grads_flat = torch.cat([g.reshape(-1) for g in grads])
    n = grads_flat.shape[0]
    H = torch.zeros(n, n)
    for i in range(n):
        grad2 = torch.autograd.grad(grads_flat[i], params, retain_graph=True)
        grad2_flat = torch.cat([g.reshape(-1) for g in grad2])
        H[i] = grad2_flat
    return H

# ==========================
# 4. Dataset
# ==========================
torch.manual_seed(0)
N = 30
x = torch.linspace(-3, 3, N).reshape(-1,1)
y_true = torch.sin(x)

# ==========================
# 5. Initialize wide network (NTK regime)
# ==========================
net = Net(1, 200, 1)
params = list(net.parameters())

# Forward pass and loss
y_pred = net(x)
loss = nn.MSELoss()(y_pred, y_true)

# ==========================
# 6. Compute NTK and Hessian
# ==========================
NTK = compute_ntk(net, x).numpy()
H = compute_hessian(loss, params).detach().numpy()

# ==========================
# 7. Plot Hessian and NTK side by side
# ==========================
plt.figure(figsize=(12,5))

plt.subplot(1,2,1)
plt.imshow(H, cmap='bwr')
plt.colorbar()
plt.title('Hessian Structure (NTK Regime)')
plt.xlabel('Parameter Index')
plt.ylabel('Parameter Index')

plt.subplot(1,2,2)
plt.imshow(NTK, cmap='bwr')
plt.colorbar()
plt.title('NTK Matrix')
plt.xlabel('Data Point Index')
plt.ylabel('Data Point Index')

plt.tight_layout()
plt.show()

# ==========================
# 8. Optional: Hessian spectrum
# ==========================
eigvals_H = torch.linalg.eigvals(torch.tensor(H)).real
plt.semilogy(sorted(eigvals_H, reverse=True))
plt.title("Hessian Spectrum (NTK Regime)")
plt.xlabel("Eigenvalue Index")
plt.ylabel("Eigenvalue")
plt.show()
