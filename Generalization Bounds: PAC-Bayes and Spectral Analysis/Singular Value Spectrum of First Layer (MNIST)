import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
from torchvision import datasets, transforms
import matplotlib.pyplot as plt
import numpy as np

# --- Define simple MLP ---
class SimpleNet(nn.Module):
    def __init__(self):
        super(SimpleNet, self).__init__()
        self.fc1 = nn.Linear(784, 256)
        self.fc2 = nn.Linear(256, 10)

    def forward(self, x):
        x = x.view(-1, 784)
        x = F.relu(self.fc1(x))
        return self.fc2(x)

# --- Training function with spectral regularization ---
def train_model(lambda_reg=0.0, epochs=5):
    model = SimpleNet()
    optimizer = optim.Adam(model.parameters(), lr=1e-3)
    train_loader = torch.utils.data.DataLoader(
        datasets.MNIST('.', train=True, download=True, transform=transforms.ToTensor()),
        batch_size=128, shuffle=True
    )

    singular_vals = []

    for epoch in range(epochs):
        for batch_idx, (data, target) in enumerate(train_loader):
            optimizer.zero_grad()
            output = model(data)
            loss = F.cross_entropy(output, target)

            # --- spectral regularization ---
            W = model.fc1.weight
            u, s, v = torch.svd(W)  # singular values
            spectral_norm = s[0]    # largest singular value
            loss = loss + lambda_reg * spectral_norm**2

            loss.backward()
            optimizer.step()

        # Track singular values at epoch end
        with torch.no_grad():
            u, s, v = torch.svd(model.fc1.weight)
            singular_vals.append(s.cpu().numpy())

    return singular_vals

# --- Run training with and without spectral regularization ---
sing_vals_no_reg = train_model(lambda_reg=0.0, epochs=5)
sing_vals_reg    = train_model(lambda_reg=1e-3, epochs=5)

# --- Plot singular value spectrum ---
plt.figure(figsize=(10,6))
for i, s in enumerate(sing_vals_no_reg):
    plt.plot(s, 'o-', alpha=0.5, label=f"No Reg Epoch {i+1}" if i==0 else "")
for i, s in enumerate(sing_vals_reg):
    plt.plot(s, 's-', alpha=0.5, label=f"Reg Epoch {i+1}" if i==0 else "")

plt.xlabel("Singular value index")
plt.ylabel("Magnitude")
plt.title("Singular Value Spectrum of First Layer (MNIST)")
plt.legend()
plt.grid(True)
plt.show()
