import numpy as np
import matplotlib.pyplot as plt

# Generate random weight matrix
np.random.seed(42)
W = np.random.randn(50, 50)

# Compute singular values
singular_vals = np.linalg.svd(W, compute_uv=False)

# Apply spectral regularization (simulate shrinkage)
lambda_reg = 0.1
singular_vals_reg = singular_vals / (1 + lambda_reg)

# Plot comparison
plt.figure(figsize=(8,6))
plt.plot(singular_vals, 'o-', label="Original Singular Values")
plt.plot(singular_vals_reg, 's-', label="After Spectral Regularization")
plt.xlabel("Index")
plt.ylabel("Singular Value")
plt.title("Effect of Spectral Regularization on Singular Values")
plt.legend()
plt.grid(True)
plt.show()

# --- Heatmap visualization of weight matrix before/after regularization ---
plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
plt.imshow(W, cmap="coolwarm")
plt.colorbar()
plt.title("Original Weight Matrix")

plt.subplot(1,2,2)
W_reg = W / (1 + lambda_reg)  # shrinkage
plt.imshow(W_reg, cmap="coolwarm")
plt.colorbar()
plt.title("After Spectral Regularization")

plt.tight_layout()
plt.show()
